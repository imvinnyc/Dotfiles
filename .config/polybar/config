;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;                                polybar                                    ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[bar/main]
width            = 100%
height           = 30
background       = #282c34cc
foreground       = #abb2bf
border-size      = 1
border-color     = #3b4048
padding-left     = 2
padding-right    = 2

;; ---------------------------------------------------------------------------
;; Fonts
;; ---------------------------------------------------------------------------
font-0 = JetBrainsMono Nerd Font:size=11;1
font-1 = Material Icons:size=12
font-2 = FontAwesome:size=12

;; ---------------------------------------------------------------------------
;; Module placement
;; ---------------------------------------------------------------------------
modules-left   = i3
modules-center = date
modules-right  = memory spacer network spacer volume spacer power

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;                            individual modules                             ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/i3]
type                  = internal/i3
format                = <label-state>
label-focused         = %index%
label-unfocused       = %index%
label-urgent          = %index%
label-focused-padding   = 1
label-unfocused-padding = 1
label-urgent-padding    = 1
label-focused-background   = #61afef
label-focused-foreground   = #282c34
label-unfocused-foreground = #5c6370
label-urgent-background    = #e06c75
label-urgent-foreground    = #ffffff
label-separator            = |
label-separator-padding    = 1

;; ---------------------------------------------------------------------------
;; centred date / time
;; ---------------------------------------------------------------------------
[module/date]
type     = internal/date
interval = 1
time = %I:%M %p
label =  %time%
label-padding    = 2
label-foreground = #61afef

;; ---------------------------------------------------------------------------
;; memory usage
;; ---------------------------------------------------------------------------
[module/memory]
type              = internal/memory
interval          = 2
format            = <label>
label             = %{T1}%{T-} RAM: %percentage_used%%
label-foreground  = #c678dd
label-padding     = 2

;; ---------------------------------------------------------------------------
;; network
;; ---------------------------------------------------------------------------
[module/network]
type          = custom/script
exec          = ~/.config/polybar/network-status.sh
interval      = 5
label-padding = 2
click-left    = ~/.config/rofi/rofi-wifi-menu.sh

;; ---------------------------------------------------------------------------
;; tiny spacer
;; ---------------------------------------------------------------------------
[module/spacer]
type     = custom/script
exec     = echo " "
interval = 600

;; ---------------------------------------------------------------------------
;; volume
;; ---------------------------------------------------------------------------
[module/volume]
type             = custom/script
exec             = ~/.config/polybar/volume-status.sh
interval         = 1

label            = %output%
label-padding    = 2
label-foreground = #e5c07b

click-left   = amixer -q sset Master toggle
scroll-up    = amixer -q sset Master 1%+
scroll-down  = amixer -q sset Master 1%-

;; ---------------------------------------------------------------------------
;; power button
;; ---------------------------------------------------------------------------
[module/power]
type             = custom/script
exec             = echo ""
interval         = 300
label-padding    = 2
label-foreground = #e06c75
click-left       = ~/.config/rofi/rofi-power-menu
